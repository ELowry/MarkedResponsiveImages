{
	"name": "marked-responsive-images",
	"version": "2.3.0",
	"description": "A robust marked extension for handling responsive images with srcset generation.",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/ELowry/MarkedResponsiveImages.git"
	},
	"bugs": {
		"url": "https://github.com/ELowry/MarkedResponsiveImages/issues"
	},
	"homepage": "https://github.com/ELowry/MarkedResponsiveImages#readme",
	"source": "src/index.js",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"unpkg": "./dist/index.umd.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"test": "node --test \"test/**/*.test.js\" && node scripts/verify-version.mjs",
		"build": "npm run format && npm run lint && npm run test && tsdown src/index.js --format cjs,esm,umd --global-name markedResponsiveImages --sourcemap --clean && node scripts/copy-definitions.mjs",
		"dev": "tsdown src/index.js --format cjs,esm,umd --global-name markedResponsiveImages --sourcemap --watch",
		"lint": "eslint src",
		"format": "prettier --write \"src/**/*.{js,ts}\"",
		"check-format": "prettier --check \"src/**/*.{js,ts}\"",
		"update": "npm update && npm ci && npm i",
		"upgrade": "npx npm-check-updates -u && npm i"
	},
	"files": [
		"dist",
		"src"
	],
	"keywords": [
		"marked",
		"markdown",
		"responsive-images",
		"srcset",
		"extension"
	],
	"author": "Eric Lowry",
	"license": "MIT",
	"peerDependencies": {
		"marked": ">=4.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.11.0",
		"marked": "^18.0.11",
		"prettier": "^3.9.6",
		"prettier-plugin-css-order": "^2.2.0",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2"
	}
}
